# REXTON WATCHES — environment template.
# Copy to `.env` (gitignored) and fill in what you need:
#     copy .env.example .env
# Every integration below runs in a safe mock mode when its keys are empty,
# so the store works out of the box.

# ── Core ────────────────────────────────────────────────────────────────────
# Public origin of the site. Used for links in emails and redirects.
APP_URL="http://localhost:3000"

# Secret used to sign session cookies. REQUIRED in production.
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""

# SQLite database file. Relative paths are resolved against prisma/ (the schema
# directory), and lib/db.ts normalises them to an absolute path so the Prisma
# CLI (migrate/seed) and the running server always open the same file.
DATABASE_URL="file:./dev.db"

# ── Payments — Razorpay ─────────────────────────────────────────────────────
# Live keys => real order creation + HMAC signature/webhook verification.
# Empty => mock mode (orders labelled mocked, checkout stays testable).
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
# Force mock mode even when keys are present: "true" or "false".
# When unset, mock mode is automatic if RAZORPAY_KEY_ID is empty.
MOCK_PAYMENTS=""

# ── Email — Resend (wired) / SMTP (reserved) ────────────────────────────────
# RESEND_API_KEY set  => real delivery through Resend.
# Neither set          => mock mode: messages are logged to the dev console
#                         and recorded as a Notification row when a user is known.
RESEND_API_KEY=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="REXTON Watches <no-reply@rexton.in>"

# ── Image storage — Cloudinary ──────────────────────────────────────────────
# CLOUDINARY_CLOUD_NAME set => signed browser uploads + CDN delivery URLs.
# Empty => mock mode: local /public/images assets (see `npm run images`).
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── Storefront ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_STORE_NAME="REXTON WATCHES"
NEXT_PUBLIC_DEFAULT_CURRENCY="INR"
